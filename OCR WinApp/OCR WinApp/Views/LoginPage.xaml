<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OCR_WinApp.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Cột trái: khung đăng nhập -->
        <Border Grid.Column="0" Width="360" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="16" KeyDown="LoginForm_KeyDown">
                <TextBlock Text="Đăng nhập" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Đăng nhập để tiếp tục"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBox Header="Tên đăng nhập" PlaceholderText="Nhập tên đăng nhập"
                         Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox Header="Mật khẩu" PlaceholderText="Nhập mật khẩu"
                             Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />

                <CheckBox Content="Ghi nhớ tôi"
                          IsChecked="{x:Bind ViewModel.RememberMe, Mode=TwoWay}" />

                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
                         IsClosable="False" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <!-- Nút Đăng nhập dùng tông màu flavor (override màu accent chỉ trong phạm vi nút). -->
                <Button Content="Đăng nhập" HorizontalAlignment="Stretch"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.LoginCommand}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource FlavorAccentColor}" />
                        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource FlavorAccentColorHover}" />
                        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource FlavorAccentColorPressed}" />
                    </Button.Resources>
                </Button>
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Cột phải: banner theo flavor. Đặt trực tiếp trong ô Grid để Uniform
             tự co ảnh vừa khít vùng (cả rộng lẫn cao) khi cửa sổ nhỏ hơn ảnh. -->
        <Image x:Name="BrandBanner" Grid.Column="1" Stretch="Uniform" Margin="24"
               MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
