<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OCR_WinApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Trang chủ" Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Text="Chọn một chức năng OCR ở menu bên trái để bắt đầu số hóa tài liệu." />

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,12,0,4"
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding HasQuota, Converter={StaticResource BoolToVisibility}}">
                <Grid ColumnSpacing="20" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="208"
                          Height="208"
                          AutomationProperties.Name="Biểu đồ quota OCR">
                        <Path Data="{Binding QuotaRemainingPercent, Converter={StaticResource DonutSliceGeometry}, ConverterParameter=remaining}"
                              Fill="#16A34A" />
                        <Path Data="{Binding QuotaRemainingPercent, Converter={StaticResource DonutSliceGeometry}, ConverterParameter=used}"
                              Fill="#DC2626" />
                        <Border Width="84"
                                Height="30"
                                Padding="4,2"
                                CornerRadius="4"
                                Background="Transparent"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Visibility="{Binding HasQuotaRemaining, Converter={StaticResource BoolToVisibility}}"
                                Margin="{Binding QuotaRemainingPercent, Converter={StaticResource DonutLabelMargin}, ConverterParameter=remaining}">
                            <TextBlock Text="{Binding QuotaRemainingText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="White" />
                        </Border>
                        <Border Width="84"
                                Height="30"
                                Padding="4,2"
                                CornerRadius="4"
                                Background="Transparent"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Visibility="{Binding HasQuotaUsed, Converter={StaticResource BoolToVisibility}}"
                                Margin="{Binding QuotaRemainingPercent, Converter={StaticResource DonutLabelMargin}, ConverterParameter=used}">
                            <TextBlock Text="{Binding QuotaUsedText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="White" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <TextBlock Text="Thống kê số lượt OCR"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{Binding QuotaSummaryText}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10" Height="10" Fill="#16A34A" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding QuotaRemainingLegendText}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                            <Ellipse Grid.Row="1" Width="10" Height="10" Fill="#DC2626" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding QuotaUsedLegendText}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Chức năng hiện có" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <ItemsControl ItemsSource="{Binding Features}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8A5;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
