<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OCR_WinApp.Views.TachGtGtkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OCR.Business.Models"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Title}" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Description}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Header="Thư mục chứa PDF không có GCN" IsReadOnly="True"
                     PlaceholderText="Chưa chọn - bấm để duyệt thư mục..."
                     Text="{x:Bind ViewModel.SelectedPath, Mode=OneWay}" />

            <Button Grid.Column="1" VerticalAlignment="Bottom" Height="32"
                    Command="{x:Bind ViewModel.PickFolderCommand}"
                    ToolTipService.ToolTip="Chọn thư mục">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    <TextBlock Text="Chọn thư mục" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" VerticalAlignment="Bottom" Height="32" Padding="16,0"
                    Command="{x:Bind ViewModel.StartCommand}"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#16A34A" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#15953F" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0F7A33" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="White" />
                    <TextBlock Text="Bắt đầu" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" VerticalAlignment="Bottom" Height="32" Padding="16,0"
                    Command="{x:Bind ViewModel.PauseCommand}"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#DC2626" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C81E1E" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A81A1A" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Rectangle Width="11" Height="11" Fill="White" />
                    <TextBlock Text="Dừng" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.FileCountText, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}" />

            <CheckBox Grid.Column="1"
                      Content="Xoay thẳng trang giấy"
                      IsChecked="{x:Bind ViewModel.NormalizePageRotation, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.CanChangeOptions, Mode=OneWay}"
                      AutomationProperties.Name="Xoay thẳng trang giấy"
                      ToolTipService.ToolTip="Tự phát hiện hướng chữ bằng OCR local và chỉ cập nhật rotate của trang PDF" />
        </Grid>

        <StackPanel Grid.Row="3" Spacing="6" Margin="0,4,0,4">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"
                       Style="{ThemeResource CaptionTextBlockStyle}"/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" Maximum="100" Height="24" CornerRadius="6"
                             VerticalAlignment="Center"
                             Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}">
                    <ProgressBar.Foreground>
                        <SolidColorBrush Color="{StaticResource FlavorAccentColor}" />
                    </ProgressBar.Foreground>
                </ProgressBar>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                           VerticalAlignment="Center" MinWidth="44" TextAlignment="Right"
                           FontWeight="SemiBold" />
                <Button Grid.Column="2" VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ExportFailedSourcesCommand}"
                        ToolTipService.ToolTip="Chọn thư mục để copy các file gốc bị lỗi trong lần chạy">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="File lỗi" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ExportCommand}"
                        ToolTipService.ToolTip="Lưu kết quả tách vào thư mục đã chọn (sau khi hoàn tất 100%)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE898;" FontSize="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <InfoBar Grid.Row="3" VerticalAlignment="Top"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
                 IsClosable="False" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <Border Grid.Row="4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25*" />
                            <ColumnDefinition Width="35*" />
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="File PDF gốc" Padding="8,8" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Trạng thái" Padding="8,8" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Số bộ" Padding="8,8" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Số file tạo" Padding="8,8" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                          SelectionMode="None"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SplitGcnRecord">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25*" />
                                    <ColumnDefinition Width="35*" />
                                    <ColumnDefinition Width="20*" />
                                    <ColumnDefinition Width="20*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind FileName}" Padding="8,6" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind TrangThai, Mode=OneWay}" Padding="8,6" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SoLuongGcn, Mode=OneWay}" Padding="8,6" />
                                <TextBlock Grid.Column="3" Text="{x:Bind SoFileTao, Mode=OneWay}" Padding="8,6" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
