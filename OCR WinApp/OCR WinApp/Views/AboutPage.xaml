<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OCR_WinApp.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="12" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Giới thiệu &amp; Liên hệ" Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap"
                       Text="OCR WinApp — giải pháp số hóa tài liệu tiếng Việt, xử lý hàng loạt theo thư mục." />

            <TextBlock Text="Liên hệ" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock Text="Email: support@example.com" />
            <TextBlock Text="Website: https://example.com" />

            <TextBlock Text="Phiên bản 1.1.0"
                       Style="{ThemeResource BodyTextBlockStyle}" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
