<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OCR_WinApp.Views.DocxVbdPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OCR.Business.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="DocxVbdFile">260</x:Double>
        <x:Double x:Key="DocxVbdTrangThai">150</x:Double>
        <x:Double x:Key="DocxVbdSerial">120</x:Double>
        <x:Double x:Key="DocxVbdChu">220</x:Double>
        <x:Double x:Key="DocxVbdThua">90</x:Double>
        <x:Double x:Key="DocxVbdTo">90</x:Double>
        <x:Double x:Key="DocxVbdDienTich">120</x:Double>
        <x:Double x:Key="DocxVbdLoaiDat">100</x:Double>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Title}" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Description}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Thanh chọn thư mục + nút Bắt đầu/Dừng -->
        <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Header="Thư mục chứa file docx Sổ cấp GCN" IsReadOnly="True"
                     PlaceholderText="Chưa chọn — bấm để duyệt thư mục..."
                     Text="{x:Bind ViewModel.SelectedPath, Mode=OneWay}" />

            <Button Grid.Column="1" VerticalAlignment="Bottom" Height="32"
                    Command="{x:Bind ViewModel.PickFolderCommand}"
                    ToolTipService.ToolTip="Chọn thư mục">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    <TextBlock Text="Chọn thư mục" />
                </StackPanel>
            </Button>

            <!-- Bắt đầu -->
            <Button Grid.Column="2" VerticalAlignment="Bottom" Height="32" Padding="16,0"
                    Command="{x:Bind ViewModel.StartCommand}"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#16A34A" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#15953F" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0F7A33" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="White" />
                    <TextBlock Text="Bắt đầu" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <!-- Dừng -->
            <Button Grid.Column="2" VerticalAlignment="Bottom" Height="32" Padding="16,0"
                    Command="{x:Bind ViewModel.PauseCommand}"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#DC2626" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C81E1E" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A81A1A" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Rectangle Width="11" Height="11" Fill="White" />
                    <TextBlock Text="Dừng" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Số lượng tệp -->
        <Grid Grid.Row="2">
            <TextBlock VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.FileCountText, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}" />
        </Grid>

        <!-- Tiến độ: status + thanh bar + % + File lỗi + Export -->
        <StackPanel Grid.Row="3" Spacing="6" Margin="0,4,0,4">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"
                       Style="{ThemeResource CaptionTextBlockStyle}"/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" Maximum="100" Height="24" CornerRadius="6"
                             VerticalAlignment="Center"
                             Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}">
                    <ProgressBar.Foreground>
                        <SolidColorBrush Color="{StaticResource FlavorAccentColor}" />
                    </ProgressBar.Foreground>
                </ProgressBar>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                           VerticalAlignment="Center" MinWidth="44" TextAlignment="Right"
                           FontWeight="SemiBold" />
                <Button Grid.Column="2" VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ExportFailedSourcesCommand}"
                        ToolTipService.ToolTip="Chọn thư mục để copy các file docx bị lỗi trong lần chạy">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="File lỗi" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ExportCommand}"
                        ToolTipService.ToolTip="Chọn thư mục lưu rồi xuất kết quả ra Excel khuôn Việt Bản Đồ (sau khi hoàn tất 100%)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE898;" FontSize="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <InfoBar Grid.Row="3" VerticalAlignment="Top"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
                 IsClosable="False" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <!-- Lưới kết quả: mỗi dòng = một thửa của một trang GCN (VietBdGcnRecord dùng chung, KHÔNG sửa).
             Không có cột Tin cậy: màn này parse thuần code, cột Trạng thái đã nêu số cảnh báo (cột FG). -->
        <Border Grid.Row="4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <Grid Width="1150">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="File / Trang" Width="{StaticResource DocxVbdFile}" Padding="8,8" FontWeight="SemiBold" />
                            <TextBlock Text="Trạng thái" Width="{StaticResource DocxVbdTrangThai}" Padding="8,8" FontWeight="SemiBold" />
                            <TextBlock Text="Số Serial" Width="{StaticResource DocxVbdSerial}" Padding="8,8" FontWeight="SemiBold" />
                            <TextBlock Text="Chủ sử dụng" Width="{StaticResource DocxVbdChu}" Padding="8,8" FontWeight="SemiBold" />
                            <TextBlock Text="Số thửa" Width="{StaticResource DocxVbdThua}" Padding="8,8" FontWeight="SemiBold" />
                            <TextBlock Text="Số tờ" Width="{StaticResource DocxVbdTo}" Padding="8,8" FontWeight="SemiBold" />
                            <TextBlock Text="Diện tích" Width="{StaticResource DocxVbdDienTich}" Padding="8,8" FontWeight="SemiBold" />
                            <TextBlock Text="Loại đất" Width="{StaticResource DocxVbdLoaiDat}" Padding="8,8" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                              SelectionMode="None"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:VietBdGcnRecord">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" Width="{StaticResource DocxVbdFile}" Padding="8,6" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind TrangThai, Mode=OneWay}" Width="{StaticResource DocxVbdTrangThai}" Padding="8,6" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SoSerial, Mode=OneWay}" Width="{StaticResource DocxVbdSerial}" Padding="8,6" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ChuSuDung, Mode=OneWay}" Width="{StaticResource DocxVbdChu}" Padding="8,6" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SoThua, Mode=OneWay}" Width="{StaticResource DocxVbdThua}" Padding="8,6" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SoTo, Mode=OneWay}" Width="{StaticResource DocxVbdTo}" Padding="8,6" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind TongDienTich, Mode=OneWay}" Width="{StaticResource DocxVbdDienTich}" Padding="8,6" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind LoaiDat, Mode=OneWay}" Width="{StaticResource DocxVbdLoaiDat}" Padding="8,6" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
